{
    "name": "gstdbot",
    "version": "1.0.0",
    "description": "Sovereign Decentralized AI Assistant — runs on the GSTD Swarm",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "gstdbot": "./dist/cli/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "gateway": "tsx src/gateway/server.ts",
        "gateway:watch": "tsx watch src/gateway/server.ts",
        "lint": "eslint src/ --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "ai",
        "assistant",
        "decentralized",
        "sovereign",
        "swarm",
        "telegram",
        "bot",
        "gstd",
        "ollama",
        "tee"
    ],
    "author": "GSTD Swarm",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/gstdcoin/gstdbot.git"
    },
    "homepage": "https://gstdbot.gstdtoken.com",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "ws": "^8.17.0",
        "express": "^4.19.0",
        "grammy": "^1.25.0",
        "ollama": "^0.5.0",
        "commander": "^12.1.0",
        "chalk": "^5.3.0",
        "inquirer": "^9.2.0",
        "ora": "^8.0.0",
        "conf": "^13.0.0",
        "zod": "^3.23.0",
        "eventsource-parser": "^1.1.0",
        "marked": "^12.0.0",
        "p-queue": "^8.0.0",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "typescript": "^5.5.0",
        "tsx": "^4.15.0",
        "@types/node": "^20.14.0",
        "@types/ws": "^8.5.10",
        "@types/express": "^4.17.21",
        "@types/uuid": "^9.0.8",
        "vitest": "^3.0.0",
        "eslint": "^9.5.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0"
    }
}