{
    "name": "gstdbot",
    "version": "3.4.0",
    "description": "GSTD Node OS — Sovereign AI platform. Swarm computing, collective memory, GSTD token economy, 8 AI models.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "gstdbot": "./dist/cli/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "gateway": "tsx src/gateway/server.ts",
        "gateway:watch": "tsx watch src/gateway/server.ts",
        "lint": "eslint src/ --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run build",
        "dashboard": "tsx src/dashboard/server.ts",
        "wallet": "tsx src/wallet/cli.ts",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f gstd-node",
        "docker:build": "docker compose build --no-cache",
        "eval:quality": "tsx src/tools/quality-eval.ts"
    },
    "keywords": [
        "ai",
        "node",
        "decentralized",
        "sovereign",
        "swarm",
        "wallet",
        "dashboard",
        "compute",
        "telegram",
        "gstd",
        "ollama",
        "tee"
    ],
    "author": "GSTD Swarm",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/gstdcoin/gstdbot.git"
    },
    "homepage": "https://gstdbot.gstdtoken.com",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@chainsafe/libp2p-noise": "^17.0.0",
        "@chainsafe/libp2p-yamux": "^8.0.1",
        "@libp2p/bootstrap": "^12.0.14",
        "@libp2p/identify": "^4.0.13",
        "@libp2p/mdns": "^12.0.14",
        "@libp2p/tcp": "^11.0.13",
        "@ton/core": "^0.63.1",
        "@ton/crypto": "^3.3.0",
        "@ton/ton": "^16.2.2",
        "@ton/walletkit": "^0.0.10",
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "conf": "^13.0.0",
        "eventsource-parser": "^1.1.0",
        "express": "^4.19.0",
        "grammy": "^1.25.0",
        "inquirer": "^9.2.0",
        "it-length-prefixed": "^10.0.1",
        "it-pipe": "^3.0.1",
        "libp2p": "^3.1.6",
        "marked": "^12.0.0",
        "ollama": "^0.5.0",
        "ora": "^8.0.0",
        "p-queue": "^8.0.0",
        "redis": "^4.7.1",
        "uint8arrays": "^5.1.0",
        "uuid": "^9.0.0",
        "ws": "^8.17.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.19.37",
        "@types/uuid": "^9.0.8",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.5.0",
        "tsx": "^4.15.0",
        "typescript": "^5.9.3",
        "vitest": "^3.0.0"
    }
}
