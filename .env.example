# ═══════════════════════════════════════════════════════
# GSTD Node OS v3.5 — Environment Configuration
# Copy to .env and fill in your values
# No external API keys required — inference is served via the GSTD network.
# ═══════════════════════════════════════════════════════

# ─── Earnings Wallet (REQUIRED for payouts) ────────────
GSTD_WALLET_ADDRESS=           # Your TON wallet address (EQ... or UQ...) — earnings go here
                               # Get one free: @wallet in Telegram, then /wallet in @gstdaibot

# ─── Node Identity ─────────────────────────────────────
NODE_NAME=my-gstd-node         # Display name in dashboard
GSTD_NODE_ID=my-gstd-node       # Stable ID — prevents duplicate entries on restart (match NODE_NAME)

# ─── AI Engine ─────────────────────────────────────────
# No external AI API keys required — inference routes through the GSTD node network.
# OLLAMA_URL=http://localhost:11434  # Optional: local Ollama for offline/sovereign mode

# ─── Telegram Bot (optional — remote management) ───────
# TELEGRAM_BOT_TOKEN=          # From @BotFather
# TELEGRAM_ADMIN_IDS=          # Comma-separated Telegram user IDs
# TELEGRAM_COMMUNITY_CHAT=     # Group chat ID for community guardian

# ─── Dashboard ─────────────────────────────────────────
GSTD_DASHBOARD_PORT=8080       # Web UI at http://localhost:8080
# GSTD_API_PORT=18789           # Alternative API port

# ─── Swarm Network ─────────────────────────────────────
SWARM_ENABLED=true
GSTD_MAX_CPU=80                # Max CPU % to allocate for tasks
GSTD_MAX_RAM=70                # Max RAM % to allocate for tasks
GSTD_API_URL=https://app.gstdtoken.com/api/v1
GSTD_SWARM_URL=https://app.gstdtoken.com  # Base URL for platform heartbeat (no /api/v1)

# ─── P2P Mesh (direct node-to-node) ───────────────────
# Comma-separated libp2p multiaddrs of known nodes.
# Any node can share its multiaddr from the dashboard.
# Format: /ip4/<HOST>/tcp/<PORT>/p2p/<PEER_ID>
# GSTD_BOOTSTRAP_PEERS=/ip4/1.2.3.4/tcp/4001/p2p/12D3KooW...
GSTD_P2P_PORT=4001             # TCP port for P2P connections
# GSTD_P2P_ANNOUNCE_IP=        # Your external/public IP (for nodes behind NAT)
# GSTD_P2P_MDNS=true           # Set false to disable LAN mDNS discovery

# ─── Blockchain Node-as-a-Service (NaaS) ──────────────
# Requires Docker. Automatically deploys chain nodes based on hardware.
# GSTD_NAAS_ENABLED=true       # TON liteserver, XRPL, ETH, SOL, etc.

# ─── Collective Memory ─────────────────────────────────
GSTD_MEMORY=false              # Set true only if a local Redis server is running
# REDIS_URL=redis://localhost:6379   # L2 shared memory
# CHROMA_URL=http://localhost:8000   # Vector embeddings

# ─── Storage Vault (optional) ─────────────────────────
# GSTD_STORAGE=/data/gstd-vault    # Path to store shards

# ─── Wallet (optional — auto-generated if not set) ────
# GSTD_WALLET_MNEMONIC=          # 24-word TON seed phrase
# TON_NETWORK=mainnet            # mainnet | testnet

# ─── Apps (Docker required) ────────────────────────────
# GSTD_APPS=true

# ─── Platform auth ─────────────────────────────────────
# WALLET_LINK_SECRET=            # Must match backend WALLET_LINK_SECRET

# ─── Security (hardened by default) ────────────────────
# Rate limit: 120 req/min per IP
# Auth lockout: 5 fails → 15min
# Encryption: AES-256-CBC
# PIN: SHA-256 hashed
