# ═══════════════════════════════════════════════════════
# GSTD Node OS v3.3 — Environment Configuration
# Copy this file to .env and edit
# ═══════════════════════════════════════════════════════

# ─── Node Identity ─────────────────────────────────────
NODE_NAME=my-gstd-node
# GSTD_NODE_ID=          # Auto-generated if empty

# ─── AI Engine ─────────────────────────────────────────
GROQ_API_KEY=            # Get free key: https://console.groq.com
# OLLAMA_URL=http://localhost:11434   # For hybrid/sovereign mode

# ─── Telegram Bot (for remote management) ─────────────
# TELEGRAM_BOT_TOKEN=    # From @BotFather — enables /status, /restart, /update, /apps, /earnings, /pin_reset
# TELEGRAM_ADMIN_IDS=    # Comma-separated user IDs for admin access
# TELEGRAM_COMMUNITY_CHAT=  # Community chat group ID (optional)

# ─── Dashboard ────────────────────────────────────────
GSTD_DASHBOARD_PORT=8080
# GSTD_API_PORT=18789
# PIN is set on first dashboard login (4-8 digits, stored as SHA-256 hash)

# ─── Swarm Network ────────────────────────────────────
SWARM_ENABLED=true
GSTD_MAX_CPU=80          # Max CPU usage % for tasks
GSTD_MAX_RAM=70          # Max RAM usage % for tasks
GSTD_API_URL=https://app.gstdtoken.com/api/v1
# GSTD_SOVEREIGNTY_MODE=full  # full | sovereign | hybrid

# ─── Collective Memory ────────────────────────────────
GSTD_MEMORY=true
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000

# ─── Apps (Docker required for app installation) ──────
GSTD_APPS=true

# ─── Security ─────────────────────────────────────────
# Rate limit: 120 requests/min per IP
# Auth lockout: 5 failed attempts → 15min lockout
# Encryption: AES-256-CBC for sensitive data
# PIN: SHA-256 hashed, never stored in plaintext
