# GSTD Node Configuration
# Copy this file: cp .env.example .env

# ─── Node Identity ────────────────────────────
NODE_NAME=my-gstd-node

# ─── Wallet ───────────────────────────────────
# Leave empty to auto-generate on first run
# Or paste your existing TON wallet seed phrase
WALLET_SEED=

# ─── Swarm Settings ──────────────────────────
SWARM_ENABLED=true
GPU_MODE=auto          # auto | cpu | gpu
MAX_CPU=80             # Max CPU usage (%)
MAX_RAM=70             # Max RAM usage (%)

# ─── Network ─────────────────────────────────
GSTD_SWARM_URL=https://app.gstdtoken.com/api/v1
OLLAMA_URL=http://localhost:11434

# ─── Dashboard ───────────────────────────────
DASHBOARD_PORT=8080

# ─── Telegram Link (optional) ────────────────
TELEGRAM_USER_ID=
